<resources>
    <!-- Every window transition is a plain fade: no sliding, so coming back from an app looks like going into one. -->
    <style name="FadeWindows" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fx_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fx_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fx_in</item>
        <item name="android:activityCloseExitAnimation">@anim/fx_out</item>
        <item name="android:taskOpenEnterAnimation">@anim/fx_in</item>
        <item name="android:taskOpenExitAnimation">@anim/fx_out</item>
        <item name="android:taskCloseEnterAnimation">@anim/fx_in</item>
        <item name="android:taskCloseExitAnimation">@anim/fx_out</item>
        <item name="android:taskToFrontEnterAnimation">@anim/fx_in</item>
        <item name="android:taskToFrontExitAnimation">@anim/fx_out</item>
        <item name="android:taskToBackEnterAnimation">@anim/fx_in</item>
        <item name="android:taskToBackExitAnimation">@anim/fx_out</item>
    </style>
    <style name="LauncherTheme" parent="@android:style/Theme.Black.NoTitleBar.Fullscreen">
        <item name="android:windowAnimationStyle">@style/FadeWindows</item>
    </style>
</resources>
