<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#214F6A" />
            <stroke android:width="2dp" android:color="#9AE9FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#193D53" />
            <stroke android:width="2dp" android:color="#A9F2FF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#102238" />
            <stroke android:width="1dp" android:color="#344E68" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
