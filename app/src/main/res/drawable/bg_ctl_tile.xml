<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><layer-list>
        <item><shape android:shape="rectangle"><solid android:color="#F2FFFFFF" /><corners android:radius="30dp" /></shape></item>
        <item><shape android:shape="rectangle"><stroke android:width="3dp" android:color="#59FFFFFF" /><corners android:radius="30dp" /></shape></item>
    </layer-list></item>
    <item><layer-list>
        <item><shape android:shape="rectangle"><solid android:color="#2EFFFFFF" /><corners android:radius="30dp" /></shape></item>
        <item android:bottom="30dp"><shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#4DFFFFFF" android:endColor="#00FFFFFF" /><corners android:radius="30dp" /></shape></item>
        <item><shape android:shape="rectangle"><stroke android:width="1.5dp" android:color="#8CFFFFFF" /><corners android:radius="30dp" /></shape></item>
    </layer-list></item>
</selector>
