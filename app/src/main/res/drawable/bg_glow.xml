<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- tvOS-style focus: no ring. A glossy specular sheen lies over the lifted tile, which keeps its rounded corners. -->
    <item><shape android:shape="rectangle"><gradient android:angle="270" android:startColor="#6EFFFFFF" android:centerColor="#1FFFFFFF" android:centerY="0.5" android:endColor="#0AFFFFFF" /><corners android:radius="26dp" /></shape></item>
    <item><shape android:shape="rectangle"><stroke android:width="1.5dp" android:color="#99FFFFFF" /><corners android:radius="26dp" /></shape></item>
</layer-list>
